# Only used by `npm run refresh:reviews` (not at runtime)
SERP_API_KEY=

# Resend — grahamswash.com is verified.
# The contact form reports an error unless the email is actually sent.
# That does not depend on an env flag (RESEND_REQUIRED is not used).
RESEND_API_KEY=
# RESEND_FROM and CONTACT_TO are required. The inbox address is not in the code,
# so the form fails with an error if either is missing. Real values live in Vercel.
RESEND_FROM="Graham's Wash <sender@your-verified-domain>"
CONTACT_TO=
CONTACT_BCC=z@zlatkobijelic.com

# Google Analytics (live Webflow property)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-P01WYBWNB8
